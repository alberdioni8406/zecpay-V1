# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (SQLite for local development)
# For production use a PostgreSQL connection string, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/zecpay?schema=public"
DATABASE_URL="file:./dev.db"

# Session / Auth secret (generate a long random string)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: future payment verification services
# ZCASH_LIGHTWALLETD_URL=
# ZCASH_RPC_URL=
# ZCASH_RPC_USER=
# ZCASH_RPC_PASSWORD=
